# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
site/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Data: raw downloads and large outputs stay out of git (rebuilt with `agent-tips`)
data/**
outputs/*
# ...except the small generated paper inputs, so the paper compiles from a fresh clone
!outputs/tables/
!outputs/figures/
outputs/figures/*
!outputs/figures/paper/
analysis/exploratory/data/
*.parquet

# LaTeX build files (the compiled paper/main.pdf is kept)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
